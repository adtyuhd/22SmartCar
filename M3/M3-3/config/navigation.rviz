# M3-3 RViz2 visualization preset for ROS 2 Humble.
# Displays are configured here; this file does not publish topics or control the robot.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /M3-2 Map1
        - /Ackermann Robot1
      Splitter Ratio: 0.55
    Tree Height: 580
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2

Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Displays:
    # Occupancy grid created during M3-2. It must remain visible under costmaps.
    - Class: rviz_default_plugins/Map
      Name: M3-2 Map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false

    # Uses the original M3-1 URDF via robot_state_publisher.
    - Class: rviz_default_plugins/RobotModel
      Name: Ackermann Robot
      Enabled: true
      Value: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      TF Prefix: ""
      Update Interval: 0

    # Red laser points. They should align with the map's occupied cells.
    - Class: rviz_default_plugins/LaserScan
      Name: Laser Scan
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 50; 50
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Decay Time: 0
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true

    - Class: rviz_default_plugins/TF
      Name: TF Frames
      Enabled: true
      Value: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0

    # Color Scheme 'costmap' displays navigation costs / inflated obstacles.
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Value: true
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Use Timestamp: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Value: true
      Alpha: 0.55
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Use Timestamp: false

    # Smac global planner publishes /plan after navigation is requested.
    - Class: rviz_default_plugins/Path
      Name: Global Planned Path
      Enabled: true
      Value: true
      Alpha: 1
      Buffer Length: 1
      Color: 0; 230; 80
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan

    # MPPI publishes this only if its visualize parameter is enabled.
    # Our current nav2_params.yaml uses visualize: false, so keep it disabled.
    - Class: rviz_default_plugins/Path
      Name: MPPI Local Reference (optional)
      Enabled: false
      Value: false
      Alpha: 1
      Buffer Length: 1
      Color: 0; 150; 255
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /transformed_global_plan

    - Class: rviz_default_plugins/Polygon
      Name: Local Robot Footprint
      Enabled: true
      Value: true
      Alpha: 1
      Color: 0; 255; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Angle: -1.5708
      Scale: 45
      X: 0
      Y: 5
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~

Window Geometry:
  Width: 1350
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false